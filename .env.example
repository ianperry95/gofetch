# PostgreSQL
POSTGRES_USER=gofetch
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gofetch

# Miniflux
MINIFLUX_ADMIN_PASSWORD=changeme
MINIFLUX_API_KEY=your-miniflux-api-key
MINIFLUX_WEBHOOK_SECRET=your-webhook-secret

# GoFetch API
GOFETCH_DATABASE_URL=postgresql+asyncpg://gofetch:changeme@postgres:5432/gofetch
GOFETCH_SECRET_KEY=change-this-to-a-random-string

# Embedding provider: "onnx" or "openai"
EMBEDDING_PROVIDER=onnx
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768

# OpenAI (only if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
